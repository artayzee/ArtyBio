                    <div id="links-editor-list" class="space-y-3"><div class="p-3.5 bg-slate-950 border border-slate-800 rounded-2xl space-y-3 relative group">
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-bold text-slate-400">Item #1</span>
                        <button onclick="removeLinkItem(0)" class="text-xs text-rose-500 hover:text-rose-400 transition">
                            <i class="fa-solid fa-trash-can"></i> Delete
                        </button>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <input type="text" value="Channel " placeholder="Title" onchange="updateLinkProperty(0, 'title', this.value)" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-brand-500">
                        <input type="text" value="Моя жизнь и всякое разное)" placeholder="Subtitle" onchange="updateLinkProperty(0, 'subtitle', this.value)" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-brand-500">
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                        <input type="text" value="https://t.me/+R31OF1Y6A80xMjk6" placeholder="URL (https://...)" onchange="updateLinkProperty(0, 'url', this.value)" class="sm:col-span-2 w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-brand-500">
                        <input type="text" value="fa-brands fa-telegram" placeholder="Icon (fa-brands fa-github)" onchange="updateLinkProperty(0, 'icon', this.value)" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-brand-500">
                    </div>
                </div><div class="p-3.5 bg-slate-950 border border-slate-800 rounded-2xl space-y-3 relative group">
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-bold text-slate-400">Item #2</span>
                        <button onclick="removeLinkItem(1)" class="text-xs text-rose-500 hover:text-rose-400 transition">
                            <i class="fa-solid fa-trash-can"></i> Delete
                        </button>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <input type="text" value="Tik Tok " placeholder="Title" onchange="updateLinkProperty(1, 'title', this.value)" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-brand-500">
                        <input type="text" value="Мой личный аккаунт" placeholder="Subtitle" onchange="updateLinkProperty(1, 'subtitle', this.value)" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-brand-500">
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                        <input type="text" value="https://www.tiktok.com/@artayzee?lang=ru-RU" placeholder="URL (https://...)" onchange="updateLinkProperty(1, 'url', this.value)" class="sm:col-span-2 w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-brand-500">
                        <input type="text" value="fa-brands fa-tiktok" placeholder="Icon (fa-brands fa-github)" onchange="updateLinkProperty(1, 'icon', this.value)" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-brand-500">
                    </div>
                </div></div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="p-4 sm:p-6 border-t border-slate-800 bg-slate-950/50 flex justify-end gap-3 rounded-b-3xl">
                <button onclick="closeEditModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800 transition">
                    Cancel
                </button>
                <button onclick="saveProfileChanges()" class="px-5 py-2 rounded-xl bg-brand-600 hover:bg-brand-500 text-xs font-semibold text-white transition shadow-lg shadow-brand-600/20">
                    Save Changes
