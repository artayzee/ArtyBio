    <div id="export-modal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="glass-card bg-slate-900 border border-slate-800 rounded-3xl w-full max-w-2xl max-h-[90vh] flex flex-col shadow-2xl">
            <!-- Modal Header -->
            <div class="p-5 sm:p-6 border-b border-slate-800 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-purple-500/10 text-purple-400 rounded-xl">
                        <i class="fa-solid fa-code text-lg"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-white">Export Page HTML</h2>
                        <p class="text-xs text-slate-400">Copy your full customized page code to use anywhere</p>
                    </div>
                </div>
                <button onclick="closeExportModal()" class="p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-full transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-5 sm:p-6 flex-1 overflow-hidden flex flex-col">
                <textarea id="export-code-area" readonly="" class="w-full flex-1 bg-slate-950 border border-slate-800 rounded-2xl p-4 font-mono text-xs text-slate-300 focus:outline-none resize-none mb-4 selection:bg-brand-500 selection:text-white" rows="12"></textarea>
                
                <div class="flex items-center justify-between">
                    <span id="toast-copied" class="text-xs text-emerald-400 font-medium opacity-0 transition-opacity" style="opacity: 0;">
                        <i class="fa-solid fa-circle-check"></i> Code copied to clipboard!
                    </span>
                    <button onclick="copyExportCode()" class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-xs font-semibold text-white transition shadow-lg shadow-brand-600/20 flex items-center gap-2">
                        <i class="fa-solid fa-copy"></i>
                        <span>Copy Code</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Initial Default Profile Data
        let profileData = {
            name: "Alex Rivera",
            subtitle: "Full Stack Developer • 🇺🇸 San Francisco • UTC-7",
            avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400&auto=format&fit=crop&q=80",
            bio: "Building next-gen web applications, UI libraries, and design systems. Feel free to connect via any of the platforms above!",
            tags: ["@alexrivera", "@arivera_dev", "github/alexr"],
            links: [
                {
                    title: "Personal Portfolio",
                    subtitle: "Check out my latest web engineering work and projects",
                    url: "https://example.com",
                    icon: "fa-solid fa-globe",
                    badge: "Featured"
                },
                {
                    title: "GitHub Repository",
                    subtitle: "Explore open-source repos, stars, and code contributions",
                    url: "https://github.com",
                    icon: "fa-brands fa-github",
                    badge: ""
                },
                {
                    title: "X / Twitter",
                    subtitle: "Daily thoughts on tech, design systems, and frontend",
                    url: "https://twitter.com",
                    icon: "fa-brands fa-x-twitter",
                    badge: ""
                },
                {
                    title: "LinkedIn Profile",
                    subtitle: "Professional resume, work history, and network",
                    url: "https://linkedin.com",
                    icon: "fa-brands fa-linkedin-in",
                    badge: ""
                },
                {
                    title: "Book a 1-on-1 Mentorship",
                    subtitle: "30 min tech career & code review session",
                    url: "https://cal.com",
                    icon: "fa-regular fa-calendar-check",
                    badge: "Available"
                }
            ]
        };

        // Render functions
        function renderPage() {
            document.getElementById('display-name').textContent = profileData.name;
            document.getElementById('footer-name').textContent = profileData.name;
            document.getElementById('display-subtitle').textContent = profileData.subtitle;
            document.getElementById('display-avatar').src = profileData.avatar;
            document.getElementById('display-bio').textContent = profileData.bio;
            document.getElementById('year').textContent = new Date().getFullYear();

            // Render Tags
            const tagsContainer = document.getElementById('display-tags');
            tagsContainer.innerHTML = '';
            profileData.tags.forEach(tag => {
                if(!tag.trim()) return;
                const badge = document.createElement('span');
                badge.className = 'px-3 py-1 rounded-full text-xs font-semibold bg-slate-800/80 hover:bg-slate-800 text-slate-300 border border-slate-700/50 transition cursor-default';
                badge.textContent = tag.trim();
                tagsContainer.appendChild(badge);
            });

            // Render Links
            const linksContainer = document.getElementById('display-links');
            linksContainer.innerHTML = '';
            profileData.links.forEach(link => {
                const linkCard = document.createElement('a');
                linkCard.href = link.url || '#';
                linkCard.target = '_blank';
                linkCard.rel = 'noopener noreferrer';
                linkCard.className = 'glass-card glass-card-hover rounded-2xl p-4 flex items-center gap-4 text-left group block relative overflow-hidden';

                const badgeHTML = link.badge ? `<span class="text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded-md bg-brand-500/20 text-brand-400 border border-brand-500/30">${link.badge}</span>` : '';

                linkCard.innerHTML = `
                    <div class="w-12 h-12 rounded-xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-center text-brand-400 group-hover:text-white group-hover:bg-brand-600 transition-colors shrink-0">
                        <i class="${link.icon || 'fa-solid fa-link'} text-xl"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-0.5">
                            <h2 class="text-sm font-bold text-white group-hover:text-brand-300 transition-colors truncate">${link.title}</h2>
                            ${badgeHTML}
                        </div>
                        <p class="text-xs text-slate-400 truncate">${link.subtitle || ''}</p>
                    </div>
                    <div class="text-slate-500 group-hover:text-white group-hover:translate-x-1 transition-all pr-1">
                        <i class="fa-solid fa-chevron-right text-xs"></i>
                    </div>
                `;
                linksContainer.appendChild(linkCard);
            });
        }

        // Modal Handlers
        function openEditModal() {
            document.getElementById('input-name').value = profileData.name;
            document.getElementById('input-subtitle').value = profileData.subtitle;
            document.getElementById('input-avatar').value = profileData.avatar;
            document.getElementById('input-bio').value = profileData.bio;
            document.getElementById('input-tags').value = profileData.tags.join(', ');

            renderModalLinksEditor();
            document.getElementById('edit-modal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('edit-modal').classList.add('hidden');
        }

        function renderModalLinksEditor() {
            const editorContainer = document.getElementById('links-editor-list');
            editorContainer.innerHTML = '';

            profileData.links.forEach((link, idx) => {
                const item = document.createElement('div');
                item.className = 'p-3.5 bg-slate-950 border border-slate-800 rounded-2xl space-y-3 relative group';
                item.innerHTML = `
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-bold text-slate-400">Item #${idx + 1}</span>
                        <button onclick="removeLinkItem(${idx})" class="text-xs text-rose-500 hover:text-rose-400 transition">
                            <i class="fa-solid fa-trash-can"></i> Delete
                        </button>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <input type="text" value="${escapeHtml(link.title)}" placeholder="Title" onchange="updateLinkProperty(${idx}, 'title', this.value)" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-brand-500">
                        <input type="text" value="${escapeHtml(link.subtitle)}" placeholder="Subtitle" onchange="updateLinkProperty(${idx}, 'subtitle', this.value)" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-brand-500">
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                        <input type="text" value="${escapeHtml(link.url)}" placeholder="URL (https://...)" onchange="updateLinkProperty(${idx}, 'url', this.value)" class="sm:col-span-2 w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-brand-500">
                        <input type="text" value="${escapeHtml(link.icon)}" placeholder="Icon (fa-brands fa-github)" onchange="updateLinkProperty(${idx}, 'icon', this.value)" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-brand-500">
                    </div>
                `;
                editorContainer.appendChild(item);
            });
        }

        function escapeHtml(str) {
            return (str || '').replace(/"/g, '&quot;');
        }

        function updateLinkProperty(index, prop, value) {
            profileData.links[index][prop] = value;
        }

        function addNewLinkItem() {
            profileData.links.push({
                title: "New Custom Link",
                subtitle: "Short link description",
                url: "https://example.com",
                icon: "fa-solid fa-link",
                badge: ""
            });
            renderModalLinksEditor();
        }

        function removeLinkItem(index) {
            profileData.links.splice(index, 1);
            renderModalLinksEditor();
        }

        function saveProfileChanges() {
            profileData.name = document.getElementById('input-name').value;
            profileData.subtitle = document.getElementById('input-subtitle').value;
            profileData.avatar = document.getElementById('input-avatar').value;
            profileData.bio = document.getElementById('input-bio').value;
            
            const rawTags = document.getElementById('input-tags').value;
            profileData.tags = rawTags.split(',').map(t => t.trim()).filter(Boolean);

            renderPage();
            closeEditModal();
        }

        // Export Functionality
        function openExportModal() {
            const docHTML = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
            document.getElementById('export-code-area').value = docHTML;
            document.getElementById('export-modal').classList.remove('hidden');
        }

        function closeExportModal() {
            document.getElementById('export-modal').classList.add('hidden');
        }

        function copyExportCode() {
            const textarea = document.getElementById('export-code-area');
            textarea.select();
            document.execCommand('copy');

            const toast = document.getElementById('toast-copied');
            toast.style.opacity = '1';
            setTimeout(() => {
                toast.style.opacity = '0';
            }, 2500);
        }

        // Initialize on load
        window.onload = function() {
            renderPage();
        };
    </script>

</body></html>
